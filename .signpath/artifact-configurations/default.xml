<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration template for the WMT PS2EXE release.
  Upload/configure as the default artifact configuration in the approved
  SignPath project. GitHub Actions upload-artifact wraps the EXE in a ZIP.
  The value of wmtVersion is supplied by release-ps2exe.yml (e.g. 6.7.0.0).
  Validate PE metadata with the actual PS2EXE build before activation.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="wmtVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="WindowsMaintenanceTool.exe"
             product-name="Windows Maintenance Tool"
             product-version="${wmtVersion}"
             file-version="${wmtVersion}"
             company-name="Windows Maintenance Tool">
      <authenticode-sign description="Windows Maintenance Tool"
                         description-url="https://github.com/Chaython/Windows-Maintenance-Tool" />
    </pe-file>
  </zip-file>
</artifact-configuration>
