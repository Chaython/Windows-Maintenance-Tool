<Window
    x:Class="WMT_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WMT_WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows Maintenance Tool — WinUI Edition"
    Activated="OnWindowActivated"
    Closed="OnWindowClosed"
    SizeChanged="OnWindowSizeChanged">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar Region -->
        <Grid x:Name="TitleBarGrid" Height="48" Background="#1A1A1E" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets\WMT.ico" Width="24" Height="24" Margin="0,0,12,0" />
            <TextBlock Grid.Column="0" Text="Windows Maintenance Tool" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" Margin="36,0,0,0" />
            <TextBlock Grid.Column="1" Text="v7.0-WinUI  •  Elevated" FontSize="11" Foreground="#A0A0A8" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BtnRefresh" Click="OnRefreshClick" Style="{StaticResource AccentButtonStyle}" Content="Refresh" Padding="12,6" />
                <Button x:Name="BtnRunScan" Click="OnRunScanClick" Style="{StaticResource DefaultButtonStyle}" Content="Run Scan" Padding="12,6" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="LeftMinimal"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="240"
            CompactPaneLength="48"
            Background="#1A1A1E"
            PaneBackground="#1A1A1E"
            SelectionChanged="OnNavSelectionChanged"
            Loaded="OnNavLoaded">

            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Dashboard" Tag="Dashboard" />
                <NavigationViewItem Icon="BackToWindow" Content="Cleaner" Tag="Cleaner" />
                <NavigationViewItem Icon="Download" Content="Updates" Tag="Updates" />
                <NavigationViewItem Icon="Devices" Content="Device Info" Tag="DeviceInfo" />
                <NavigationViewItem Icon="Globe" Content="Network" Tag="Network" />
                <NavigationViewItem Icon="HardDrive" Content="Storage" Tag="Storage" />
                <NavigationViewItem Icon="BatteryCharging" Content="Power" Tag="Power" />
                <NavigationViewItem Icon="Setting" Content="Settings" Tag="Settings" />
            </NavigationView.MenuItems>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox PlaceholderText="Search settings or commands..." QueryIcon="Find" Width="300" />
            </NavigationView.AutoSuggestBox>

            <Grid x:Name="ContentGrid" Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="240" />
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame" Grid.Row="0" />

                <!-- Log Panel -->
                <Border Grid.Row="1" Margin="0,16,0,0" Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Operation Log" FontWeight="SemiBold" Foreground="#F1F1F3" FontSize="14" Margin="0,0,0,8" />
                        <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                            <TextBlock x:Name="LogTextBlock" Text="[Welcome] WMT WinUI initialized successfully.\n[Info] Engine version: 7.0-WinUI\n[Info] Background manager started." FontFamily="Consolas, monospace" FontSize="12" Foreground="#C0C0C8" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#16161A" BorderThickness="0,1,0,0" BorderBrush="#33333A" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="StatusIndicator" Text="● Ready" Foreground="#3FB950" FontSize="11" FontWeight="Bold" />
                    <TextBlock x:Name="StatusMessage" Text="Waiting for command..." Foreground="#A0A0A8" FontSize="11" />
                </StackPanel>
                <ProgressRing x:Name="ProgressRing" Grid.Column="2" IsActive="False" Width="20" Height="20" Foreground="#0078D4" />
            </Grid>
        </Border>
    </Grid>
</Window>
