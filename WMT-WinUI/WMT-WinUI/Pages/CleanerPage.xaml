<Page
    x:Class="WMT_WinUI.Pages.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,16,0,24" Spacing="16">
            <TextBlock Text="System Cleaner" FontSize="24" FontWeight="Bold" Foreground="#F1F1F3" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Standard Clean" FontSize="16" FontWeight="SemiBold" Foreground="#F1F1F3" />
                        <TextBlock Text="Removes temporary files, prefetch data, and system cache. Safe for regular maintenance." Foreground="#A0A0A8" FontSize="12" TextWrapping="Wrap" />
                        <Button Content="Run Clean" Click="OnRunCleanClick" HorizontalAlignment="Left" Padding="16,8" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Deep Clean" FontSize="16" FontWeight="SemiBold" Foreground="#F1F1F3" />
                        <TextBlock Text="Performs registry backup, removes old update files, and executes full system optimization." Foreground="#A0A0A8" FontSize="12" TextWrapping="Wrap" />
                        <Button Content="Run Deep Clean" Click="OnDeepCleanClick" HorizontalAlignment="Left" Padding="16,8" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Cleaner Refresh" FontSize="16" FontWeight="SemiBold" Foreground="#F1F1F3" />
                    <TextBlock Text="Refreshes the cleaner source database and updates cleaning rules from the latest definitions." Foreground="#A0A0A8" FontSize="12" TextWrapping="Wrap" />
                    <Button Content="Refresh Sources" Click="OnRefreshSourcesClick" HorizontalAlignment="Left" Padding="16,8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
