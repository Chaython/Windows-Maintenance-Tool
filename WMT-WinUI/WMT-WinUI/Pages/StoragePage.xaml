<Page x:Class="WMT_WinUI.Pages.StoragePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,16,0,24" Spacing="16">
            <TextBlock Text="Storage Management" FontSize="24" FontWeight="Bold" Foreground="#F1F1F3" />
            <Border Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Fixed Volumes" FontSize="16" FontWeight="SemiBold" Foreground="#F1F1F3" />
                    <TextBlock Text="Detected storage volumes will be displayed with health and usage metrics." Foreground="#A0A0A8" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Cleanup Tools" FontSize="16" FontWeight="SemiBold" Foreground="#F1F1F3" />
                    <Button Content="Run Disk Cleanup" Click="OnCleanupClick" HorizontalAlignment="Left" Padding="16,8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
