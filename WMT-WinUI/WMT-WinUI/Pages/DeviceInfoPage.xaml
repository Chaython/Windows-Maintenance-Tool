<Page x:Class="WMT_WinUI.Pages.DeviceInfoPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,16,0,24" Spacing="16">
            <TextBlock Text="Device Information" FontSize="24" FontWeight="Bold" Foreground="#F1F1F3" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Core System" FontWeight="SemiBold" FontSize="16" Foreground="#F1F1F3" />
                        <TextBlock x:Name="TxtOsInfo" Text="Gathering OS data..." Foreground="#A0A0A8" FontSize="12" />
                        <TextBlock x:Name="TxtCpuInfo" Text="Gathering CPU data..." Foreground="#A0A0A8" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Memory & Storage" FontWeight="SemiBold" FontSize="16" Foreground="#F1F1F3" />
                        <TextBlock x:Name="TxtRamInfo" Text="Gathering RAM data..." Foreground="#A0A0A8" FontSize="12" />
                        <TextBlock x:Name="TxtStorageInfo" Text="Gathering storage data..." Foreground="#A0A0A8" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="#16161A" BorderBrush="#33333A" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Network & Power" FontWeight="SemiBold" FontSize="16" Foreground="#F1F1F3" />
                    <TextBlock x:Name="TxtNetworkInfo" Text="Gathering network details..." Foreground="#A0A0A8" FontSize="12" />
                    <TextBlock x:Name="TxtPowerInfo" Text="Gathering power details..." Foreground="#A0A0A8" FontSize="12" />
                </StackPanel>
            </Border>
            <Button Content="Export Full Report" Click="OnExportClick" HorizontalAlignment="Left" Padding="16,8" />
        </StackPanel>
    </ScrollViewer>
</Page>
